EODHD_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Valgfri AI-oppsummering. Uten nøkkel vises overskrifter og kilder.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Krever tilgang til Financial News API hos EODHD. Google News er alltid på.
EODHD_NEWS_ENABLED=false
# Aktiver bare etter at Reddit har godkjent gratis tilgang for denne bruken.
REDDIT_ENABLED=false
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: server:stockagent:v1.0 (by /u/ditt_reddit_brukernavn)
REDDIT_USER_AGENT=
REDDIT_SUBREDDITS=aksjer,SalmonEvolution
# Bare nødvendig hvis du bruker HTTP-endepunktene for cron eller kurssynk.
# Bruk en tilfeldig hemmelighet på minst 32 tegn.
CRON_SECRET=
